{
  "name": "Blog MVP",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install -e '.[dashboard]'",
  "forwardPorts": [
    8501
  ],
  "portsAttributes": {
    "8501": {
      "label": "블로그 검토 대시보드",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "bash .devcontainer/start.sh"
}
